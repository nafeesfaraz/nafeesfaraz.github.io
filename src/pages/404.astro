---
import { SITE_TITLE } from '../consts';
import Base from '../layouts/Base.astro';
---

<Base title={`Page not found · ${SITE_TITLE}`} description="This page doesn't exist.">
	<section class="container page-top notfound">
		<p class="eyebrow">404</p>
		<h1>This page doesn't exist.</h1>
		<p>It may have moved. <a href="/">Go to the home page</a>.</p>
	</section>
</Base>

<style>
	.notfound {
		padding-bottom: 2rem;
	}
	h1 {
		margin-bottom: 1rem;
	}
</style>
