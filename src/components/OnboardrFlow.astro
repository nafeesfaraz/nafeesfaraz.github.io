---
import { GATE_LEGEND } from '../consts';

// System map of the OnboardR flow. Gates are steps the flow cannot pass until they succeed.
const steps = [
	{
		actor: 'Seller',
		title: 'Enter the organisation number',
		text: "The seller starts with the merchant's organisation number and picks the partner the deal belongs to.",
		systems: [],
	},
	{
		actor: 'OnboardR',
		title: 'Look up the company and check its credit',
		text: 'Brreg fills in the company details, revenue and headcount. Experian scores the company. Below the minimum score, no lead is created.',
		systems: ['Brreg', 'Experian'],
		gate: 'Stops on a failed check',
	},
	{
		actor: 'Seller',
		title: 'Set the deal terms',
		text: "Services, payment methods and fees, with prices prefilled from the partner's rate card.",
		systems: [],
	},
	{
		actor: 'OnboardR',
		title: 'Generate the agreement',
		text: 'The partnership agreement and the annexes that match the chosen services and acquirer.',
		systems: [],
	},
	{
		actor: 'Merchant',
		title: 'Screen, then sign',
		text: 'Each signatory completes KYC with PEP and sanctions screening, then signs with BankID.',
		systems: ['KYCFlow', 'BankID'],
		gate: 'Signing waits for KYC',
	},
	{
		actor: 'Operations',
		title: 'Hand over to operations',
		text: 'Operations gets an email with a summary PDF of the company, its checks and the signed agreement.',
		systems: ['Postmark'],
	},
];

const stages = ['Sent', 'Signed', 'Onboarding', 'Completed'];
---

<figure class="flow wide">
	<figcaption class="caption">
		<span class="caption-title">How a merchant moves through OnboardR</span>
		<span class="gate-legend">{GATE_LEGEND}</span>
	</figcaption>
	<ol class="steps">
		{
			steps.map((step, i) => (
				<li class:list={['step', { 'is-gate': step.gate }]}>
					<span class="num" aria-hidden="true">
						{String(i + 1).padStart(2, '0')}
					</span>
					<div class="card">
						<p class="meta">
							<span>{step.actor}</span>
							{step.gate && <span class="gate gate-mark">{step.gate}</span>}
						</p>
						<p class="title">{step.title}</p>
						<p class="text">{step.text}</p>
					</div>
					{step.systems.length > 0 && (
						<ul class="systems" aria-label="Connected systems">
							{step.systems.map((system) => (
								<li class="chip">{system}</li>
							))}
						</ul>
					)}
				</li>
			))
		}
	</ol>
	<div class="stages">
		<p class="stages-label">Pipeline stages</p>
		<ol class="chain">
			{
				stages.map((stage) => (
					<li>
						<span class="chip">{stage}</span>
					</li>
				))
			}
		</ol>
	</div>
</figure>

<style>
	.flow {
		padding: 1.5rem 1.25rem;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--surface);
		font-size: 0.9375rem;
	}
	.caption {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.5rem 1.5rem;
		/* Sets every side, so .prose figcaption's top margin doesn't apply. */
		margin: 0 0 1.75rem;
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		color: var(--fg-muted);
	}
	.caption-title {
		color: var(--fg);
		font-weight: 500;
	}

	.steps {
		position: relative;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	/* The spine that joins the numbered steps. */
	.steps::before {
		content: '';
		position: absolute;
		top: 1rem;
		bottom: 1rem;
		left: calc(1rem - 1px);
		width: 2px;
		background: var(--border);
	}
	.step {
		position: relative;
		display: grid;
		grid-template-columns: 2rem minmax(0, 1fr);
		column-gap: 0.875rem;
		row-gap: 0.5rem;
	}
	.step + .step {
		margin-top: 1.25rem;
	}
	.num {
		display: grid;
		place-items: center;
		width: 2rem;
		height: 2rem;
		border: 1px solid var(--border);
		border-radius: 50%;
		background: var(--surface);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--fg-muted);
	}
	.card {
		padding: 0.85rem 1rem;
		border: 1px solid var(--border);
		border-radius: 8px;
		background: var(--bg);
	}
	.is-gate .num,
	.is-gate .card {
		border-color: var(--gate);
	}
	.is-gate .num {
		color: var(--gate);
		background: var(--gate-soft);
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.25rem 1rem;
		margin: 0 0 0.35rem;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--fg-subtle);
	}
	.gate {
		color: var(--gate);
	}
	.title {
		margin: 0 0 0.25rem;
		font-weight: 600;
		line-height: 1.35;
	}
	.text {
		margin: 0;
		color: var(--fg-muted);
		line-height: 1.5;
	}
	.systems {
		grid-column: 2;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.stages {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 1rem;
		margin-top: 1.75rem;
		padding-top: 1.25rem;
		border-top: 1px dashed var(--border);
	}
	.stages-label {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--fg-muted);
	}

	/* Wider screens: connected systems sit in their own column, joined by a dashed line. */
	@media (min-width: 48rem) {
		.flow {
			padding: 2rem;
		}
		.step {
			grid-template-columns: 2rem minmax(0, 1fr) 13rem;
			align-items: start;
		}
		.systems {
			grid-column: 3;
			grid-row: 1;
			margin-top: 0.85rem;
		}
		.systems::before {
			content: '';
			width: 1.25rem;
			border-top: 1px dashed var(--fg-subtle);
		}
	}
</style>
