---
import { SITE_TITLE } from '../consts';

const path = Astro.url.pathname;
const links = [
	{ href: '/#work', label: 'Work', current: path.startsWith('/work') ? 'true' : undefined },
	{ href: '/about/', label: 'About', current: path.startsWith('/about') ? 'page' : undefined },
];
---

<header class="site-header">
	<nav class="container-wide" aria-label="Main">
		<a class="name" href="/">{SITE_TITLE}</a>
		<ul>
			{
				links.map((link) => (
					<li>
						<a href={link.href} aria-current={link.current}>
							{link.label}
						</a>
					</li>
				))
			}
			<li>
				<button class="theme-toggle" type="button" aria-pressed="false">
					<span class="sr-only">Dark theme</span>
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<circle cx="12" cy="12" r="8.5"></circle>
						<path class="half" d="M12 3.5a8.5 8.5 0 0 1 0 17z"></path>
					</svg>
				</button>
			</li>
		</ul>
	</nav>
</header>

<script>
	const root = document.documentElement;
	const button = document.querySelector<HTMLButtonElement>('.theme-toggle');
	const media = window.matchMedia('(prefers-color-scheme: dark)');
	const current = () => root.dataset.theme ?? (media.matches ? 'dark' : 'light');
	const sync = () => button?.setAttribute('aria-pressed', String(current() === 'dark'));

	button?.addEventListener('click', () => {
		const next = current() === 'dark' ? 'light' : 'dark';
		root.dataset.theme = next;
		try {
			localStorage.setItem('theme', next);
		} catch {}
		sync();
	});
	media.addEventListener('change', sync);
	sync();
</script>

<style>
	.site-header {
		border-bottom: 1px solid var(--border);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		min-height: 4rem;
	}
	.name {
		color: var(--fg);
		font-weight: 600;
		letter-spacing: -0.01em;
		text-decoration: none;
	}
	ul {
		display: flex;
		align-items: center;
		gap: 0.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	ul a {
		display: inline-block;
		padding: 0.5rem 0.75rem;
		border-radius: 6px;
		color: var(--fg-muted);
		text-decoration: none;
	}
	ul a:hover,
	ul a[aria-current] {
		color: var(--fg);
	}
	ul a[aria-current] {
		text-decoration: underline;
		text-decoration-thickness: 2px;
		text-underline-offset: 0.4em;
	}
	.theme-toggle {
		display: grid;
		place-items: center;
		width: 2.25rem;
		height: 2.25rem;
		margin-left: 0.25rem;
		padding: 0;
		border: 1px solid var(--border);
		border-radius: 8px;
		background: transparent;
		color: var(--fg-muted);
		cursor: pointer;
	}
	.theme-toggle:hover {
		color: var(--fg);
	}
	.theme-toggle svg {
		width: 1.1rem;
		height: 1.1rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.75;
	}
	.theme-toggle .half {
		fill: currentColor;
		stroke: none;
	}
</style>
