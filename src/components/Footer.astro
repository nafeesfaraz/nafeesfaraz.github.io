---
import { EMAIL, LINKEDIN_URL, SITE_TITLE, SOURCE_URL } from '../consts';

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container-wide">
		<p class="colophon">
			<span>&copy; {year} {SITE_TITLE}</span>
			<span>Built with Claude Code</span>
			<a href={SOURCE_URL}>Source on GitHub</a>
		</p>
		<ul>
			<li><a href={`mailto:${EMAIL}`}>Email</a></li>
			<li><a href={LINKEDIN_URL}>LinkedIn</a></li>
		</ul>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: 6rem;
		padding: 2rem 0 3rem;
		border-top: 1px solid var(--border);
		font-size: 0.875rem;
		color: var(--fg-muted);
	}
	.container-wide {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 1rem 2rem;
	}
	.colophon {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.25rem;
		margin: 0;
	}
	a {
		display: inline-block;
		padding-block: 0.25rem;
		color: var(--fg-muted);
	}
	a:hover {
		color: var(--fg);
	}
	ul {
		display: flex;
		gap: 1.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
</style>
